# Storyblok
STORYBLOK_SPACE_ID=<your-space-id>
NEXT_PUBLIC_STORYBLOK_TOKEN=<your-public-token>
STORYBLOK_PREVIEW_TOKEN=<your-preview-token>
STORYBLOK_MANAGEMENT_TOKEN=<your-personal-access-token>

# Auth / webhooks
API_SECRET=<draft-route-secret>
# Only needed once the webhook exists on a deployed host. Defaults to a
# placeholder locally; required in production.
STORYBLOK_WEBHOOK_SECRET=<storyblok-webhook-signing-secret>

# Site
SITE_URL=https://example.ch
SITE_NAME=Example
# 'preview' = drafts + noindex + bridge; 'live' = published + indexable
MODE=live

# CI-only escape hatch for verifying a production build without CMS network access.
# Never set this on a deployed site.
# STORYBLOK_SKIP_FETCH=true

# Analytics
NEXT_PUBLIC_PIRSCH_CODE=<your-pirsch-code>
