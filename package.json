{
  "name": "next-storyblok",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,mts,mjs,js,css}\" \"messages/*.json\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mts,mjs,js,css}\" \"messages/*.json\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "scripts/smoke-dev.sh",
    "check": "yarn format:check && yarn lint && yarn typecheck && yarn test && yarn types:check",
    "sync": "storyblok components pull && storyblok types generate",
    "types:check": "node scripts/check-storyblok-types.mjs",
    "assets:unused": "node scripts/find-unused-assets.mjs",
    "scaffold": "node generators/cli.mjs",
    "setup:space": "node scripts/setup-space.mjs"
  },
  "dependencies": {
    "@sankara-ui/core": "^0.10.0",
    "@storyblok/react": "^7.5.2",
    "@t3-oss/env-nextjs": "^0.13.11",
    "next": "^16.4.6",
    "next-intl": "^4.16.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storyblok-js-client": "^7.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "postcss": "^8.5.33",
    "prettier": "3.10.1",
    "storyblok": "^4.21.2",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": "^22.14.0"
  },
  "packageManager": "yarn@4.7.0"
}
